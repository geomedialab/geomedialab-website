---
# Meta-refresh stubs for URLs of the old hand-made site (team.html, cicada.html, …).
# The list lives in src/_data/legacyRedirects.json; .eleventy.js resolves each
# content folder to its current URL.
pagination:
  data: collections.legacyRedirects
  size: 1
  alias: r
permalink: "{% if r.from.endsWith('/') %}{{ r.from }}index.html{% else %}{{ r.from }}{% endif %}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html><head><meta charset="utf-8"><link rel="canonical" href="{{ r.to }}"><meta http-equiv="refresh" content="0; url={{ r.to }}"></head>
<body><a href="{{ r.to }}">{{ r.to }}</a></body></html>
